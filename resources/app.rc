#include <windows.h>
#include <verrsrc.h>
#include "../src/BuildVersion.h"

// ID 1 = primary application icon (shown on TinyRdp.exe in Explorer).
#define IDI_APPICON 1
#define IDR_CHANGELOG 101

IDI_APPICON ICON "app.ico"

IDR_CHANGELOG RCDATA "changelog.txt"

1 RT_MANIFEST "app.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION SECURE_RDP_FILE_VERSION
PRODUCTVERSION SECURE_RDP_FILE_VERSION
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "TinyRdp"
            VALUE "FileDescription", "Tiny RDP Connection Manager"
            VALUE "FileVersion", SECURE_RDP_FILE_VERSION_STR
            VALUE "InternalName", "TinyRdp"
            VALUE "OriginalFilename", "TinyRdp.exe"
            VALUE "ProductName", "Tiny RDP Connection Manager"
            VALUE "ProductVersion", SECURE_RDP_FILE_VERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
