#include <windows.h>
#include <verrsrc.h>

// ID 1 = primary application icon (shown on SecureRdp.exe in Explorer).
#define IDI_APPICON 1

IDI_APPICON ICON "app.ico"

1 RT_MANIFEST "app.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION 1,0,0,0
PRODUCTVERSION 1,0,0,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "SecureRdp"
            VALUE "FileDescription", "Secure RDP Connection Manager"
            VALUE "FileVersion", "0.0.1.0"
            VALUE "InternalName", "SecureRdp"
            VALUE "OriginalFilename", "SecureRdp.exe"
            VALUE "ProductName", "Secure RDP Connection Manager"
            VALUE "ProductVersion", "0.0.1.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
